[export, sideeffects]
def SlopeDiv(var num : uint; var den : uint) : int {
    var ans : uint
    if (den < 512u) {
        return 2048
    } else {
        ans = (num << 3u) / (den >> 8u)
        if (ans <= 2048u) {
            return int(ans)
        } else {
            return 2048
        }
    }
}
