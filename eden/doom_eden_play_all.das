// Refills the function tables (at start, and after a hot reload).
def c2da_relink() {
    resize(c2da_fn_table0, 194)
    c2da_fn_table0[1] = @@ST_loadCallback
    c2da_fn_table0[2] = @@A_Light0
    c2da_fn_table0[3] = @@A_WeaponReady
    c2da_fn_table0[4] = @@A_Lower
    c2da_fn_table0[5] = @@A_Raise
    c2da_fn_table0[6] = @@A_Punch
    c2da_fn_table0[7] = @@A_ReFire
    c2da_fn_table0[8] = @@A_FirePistol
    c2da_fn_table0[9] = @@A_Light1
    c2da_fn_table0[10] = @@A_FireShotgun
    c2da_fn_table0[11] = @@A_Light2
    c2da_fn_table0[12] = @@A_FireShotgun2
    c2da_fn_table0[13] = @@A_CheckReload
    c2da_fn_table0[14] = @@A_OpenShotgun2
    c2da_fn_table0[15] = @@A_LoadShotgun2
    c2da_fn_table0[16] = @@A_CloseShotgun2
    c2da_fn_table0[17] = @@A_FireCGun
    c2da_fn_table0[18] = @@A_GunFlash
    c2da_fn_table0[19] = @@A_FireMissile
    c2da_fn_table0[20] = @@A_Saw
    c2da_fn_table0[21] = @@A_FirePlasma
    c2da_fn_table0[22] = @@A_BFGsound
    c2da_fn_table0[23] = @@A_FireBFG
    c2da_fn_table0[165] = @@WI_unloadCallback
    c2da_fn_table0[166] = @@WI_loadCallback
    c2da_fn_table0[169] = @@G_BuildTiccmd
    c2da_fn_table0[170] = @@RunTic
    c2da_fn_table0[193] = @@ST_unloadCallback
    resize(c2da_fn_table1, 194)
    c2da_fn_table1[24] = @@A_BFGSpray
    c2da_fn_table1[25] = @@A_Explode
    c2da_fn_table1[26] = @@A_Pain
    c2da_fn_table1[27] = @@A_PlayerScream
    c2da_fn_table1[28] = @@A_Fall
    c2da_fn_table1[29] = @@A_XScream
    c2da_fn_table1[30] = @@A_Look
    c2da_fn_table1[31] = @@A_Chase
