[export, sideeffects]
def P_Random() : int {
    prndindex = prndindex + 1 & 255
    return int(rndtable[prndindex])
}
[export, sideeffects]
def M_Random() : int {
    rndindex = rndindex + 1 & 255
    return int(rndtable[rndindex])
}
[export, sideeffects]
def M_ClearRandom() {
